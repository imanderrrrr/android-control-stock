<?xml version="1.0" encoding="utf-8"?>
<!-- Header de pedido de otro vendedor — rediseño "Bosque Pro" (fila anidada en la ruta).
     Conserva ids: textOtrosClientName, textOtrosCreatedAt, textOtrosAddress, textOtrosSeller,
     textOtrosItemsCount, textOtrosStatusLabel, textOtrosTotal, btnOtrosDownload,
     progressOtrosDownload, btnOtrosPrint. Nuevo: textOtrosInicial. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/bg_muted"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Avatar con iniciales -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/brand_soft"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/textOtrosInicial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/brand_soft_text"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="CM" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Bloque de información -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textOtrosClientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="Carlos Méndez" />

            <TextView
                android:id="@+id/textOtrosCreatedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                tools:text="20 Feb 2026" />

            <TextView
                android:id="@+id/textOtrosAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="10ª calle 7-32, Zona 11" />

            <TextView
                android:id="@+id/textOtrosSeller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Vendedor: Ana" />

            <!-- Items + estado de descarga -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textOtrosItemsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    tools:text="6 ítem(s)" />

                <TextView
                    android:id="@+id/textOtrosStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/brand_soft"
                    android:fontFamily="sans-serif"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/brand_soft_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="Descargado" />
            </LinearLayout>

            <TextView
                android:id="@+id/textOtrosTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/brand_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Q980.00"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Acción de descarga / impresión -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp">

            <ImageButton
                android:id="@+id/btnOtrosDownload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/otros_download_btn_desc"
                android:padding="8dp"
                android:src="@drawable/ic_download"
                app:tint="@color/brand_accent" />

            <ProgressBar
                android:id="@+id/progressOtrosDownload"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/brand_accent"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnOtrosPrint"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Imprimir ticket"
                android:padding="8dp"
                android:src="@drawable/ic_print"
                android:visibility="gone"
                app:tint="@color/brand_accent" />

        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
