<?xml version="1.0" encoding="utf-8"?>
<!-- Pedido confirmado — rediseño "Bosque Pro" (pantalla de éxito, fondo verde).
     Ids: textConfirmedRef, textConfirmedClientName, textConfirmedClientAddress,
     textConfirmedProducts, textConfirmedTotal, btnContinueRoute, btnViewDetail.
     Inset superior por código. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_primary">

    <!-- Contenido central -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        app:layout_constraintBottom_toTopOf="@id/confirmedButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <!-- Check -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="84dp"
            android:layout_height="84dp"
            app:cardBackgroundColor="@color/brand_accent"
            app:cardCornerRadius="42dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/text_on_inverse" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="-0.02"
            android:text="@string/order_confirmed_title"
            android:textColor="@color/text_on_inverse"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="@string/order_confirmed_subtitle"
            android:textColor="@color/text_on_inverse_muted"
            android:textSize="13sp" />

        <!-- Referencia -->
        <TextView
            android:id="@+id/textConfirmedRef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/brand_accent"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="@color/text_on_inverse"
            android:textSize="13sp"
            tools:text="#PED-2026-1284" />

        <!-- Resumen -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="@string/order_confirmed_client_label"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/textConfirmedClientName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    tools:text="Tienda Rosita" />

                <TextView
                    android:id="@+id/textConfirmedClientAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="10ª calle 7-32, Zona 11"
                    tools:visibility="visible" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/border_subtle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.06"
                            android:text="@string/order_confirmed_products_label"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/textConfirmedProducts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            tools:text="5 ítems · 31 unidades" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.06"
                            android:text="@string/order_confirmed_total_label"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/textConfirmedTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/brand_accent"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Q1,301.66" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Botones -->
    <LinearLayout
        android:id="@+id/confirmedButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueRoute"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/order_confirmed_continue"
            android:textAllCaps="false"
            android:textColor="@color/brand_primary"
            android:textSize="15sp"
            app:backgroundTint="@color/brand_soft"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd"
            app:iconTint="@color/brand_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewDetail"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/order_confirmed_detail"
            android:textAllCaps="false"
            android:textColor="@color/text_on_inverse"
            android:textSize="14sp"
            app:cornerRadius="16dp"
            app:rippleColor="@color/brand_accent"
            app:strokeColor="@color/text_on_inverse_muted"
            app:strokeWidth="1dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
