<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del historial de movimientos en el detalle de producto (4.1). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/movementDelta"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:textColor="@color/success_text"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="+12" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/movementReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Compra" />

        <TextView
            android:id="@+id/movementMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            tools:text="08/09/2026 14:32 · Yonatan · Pendiente de subir" />

        <TextView
            android:id="@+id/movementNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Llegó camión" />
    </LinearLayout>
</LinearLayout>
