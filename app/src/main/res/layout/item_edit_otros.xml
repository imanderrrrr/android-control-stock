<?xml version="1.0" encoding="utf-8"?>
<!-- Ítem de la lista editable de un pedido ajeno (Otros). Sin imagen ni descuento. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/palette_300"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Botón quitar (esquina superior derecha) -->
        <ImageButton
            android:id="@+id/btnDeleteEditOtrosItem"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit_pedido_delete_item"
            android:src="@drawable/ic_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Nombre del producto -->
        <TextView
            android:id="@+id/textEditOtrosNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteEditOtrosItem"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Precio unitario -->
        <TextView
            android:id="@+id/textEditOtrosPrecio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:alpha="0.65"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/textEditOtrosSubtotal"
            app:layout_constraintTop_toBottomOf="@id/textEditOtrosNombre" />

        <!-- Subtotal del ítem (derecha) -->
        <TextView
            android:id="@+id/textEditOtrosSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnDeleteEditOtrosItem" />

        <!-- Controles de cantidad: − qty + -->
        <ImageButton
            android:id="@+id/btnDecrOtrosQty"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Decrementar"
            android:src="@drawable/ic_remove"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textEditOtrosPrecio"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/textEditOtrosQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/btnDecrOtrosQty"
            app:layout_constraintTop_toTopOf="@id/btnDecrOtrosQty"
            app:layout_constraintBottom_toBottomOf="@id/btnDecrOtrosQty" />

        <ImageButton
            android:id="@+id/btnIncrOtrosQty"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Incrementar"
            android:src="@drawable/ic_add"
            app:layout_constraintStart_toEndOf="@id/textEditOtrosQty"
            app:layout_constraintTop_toTopOf="@id/btnDecrOtrosQty"
            app:layout_constraintBottom_toBottomOf="@id/btnDecrOtrosQty" />

        <!-- Detalle / nota del ítem (opcional) -->
        <TextView
            android:id="@+id/textEditOtrosNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textStyle="italic"
            android:alpha="0.7"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnDecrOtrosQty" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
