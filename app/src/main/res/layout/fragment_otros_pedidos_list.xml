<?xml version="1.0" encoding="utf-8"?>
<!-- Tab "Otros Pedidos": filtro de fecha propio + lista de rutas con headers de otros vendedores -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- ── Selector de fecha (independiente de Mis Pedidos) ─────────────── -->
    <LinearLayout
        android:id="@+id/layoutDateFilterOtros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFechaFiltroOtros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.Chip.Action"
            app:chipIcon="@drawable/ic_calendar_month"
            app:chipIconTint="?attr/colorPrimary"
            app:chipIconSize="18dp"
            app:chipBackgroundColor="?attr/colorPrimaryVariant"
            android:textColor="?attr/colorOnPrimary"
            android:checkable="false" />

        <!-- Botón "Hoy" para resetear el filtro a hoy -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFechaHoyOtros"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/pedidos_date_filter_today"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ── Lista de rutas ────────────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerOtrosPedidosList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="80dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <ProgressBar
            android:id="@+id/progressOtrosPedidosList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textOtrosPedidosListEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/otros_pedidos_empty"
            android:textAppearance="?attr/textAppearanceBody1"
            android:alpha="0.5"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
