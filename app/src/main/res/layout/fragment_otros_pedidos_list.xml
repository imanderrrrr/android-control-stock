<?xml version="1.0" encoding="utf-8"?>
<!-- Tab "Otros Pedidos" — rediseño "Bosque Pro": banner solo-lectura + filtro de fecha + lista.
     Conserva ids: layoutDateFilterOtros, chipFechaFiltroOtros, btnFechaHoyOtros,
     recyclerOtrosPedidosList, progressOtrosPedidosList, textOtrosPedidosListEmpty. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- ── Banner solo lectura ───────────────────────────────────────────── -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/info_bg"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="11dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_info"
                app:tint="@color/info_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif"
                android:text="@string/otros_readonly_banner"
                android:textColor="@color/info_text"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── Selector de fecha (independiente de Mis Pedidos) ─────────────── -->
    <LinearLayout
        android:id="@+id/layoutDateFilterOtros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFechaFiltroOtros"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_soft_text"
            android:textSize="13sp"
            android:checkable="false"
            app:chipBackgroundColor="@color/brand_soft"
            app:chipIcon="@drawable/ic_calendar_month"
            app:chipIconSize="18dp"
            app:chipIconTint="@color/brand_accent"
            app:chipStrokeWidth="0dp" />

        <!-- Botón "Hoy" para resetear el filtro a hoy -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFechaHoyOtros"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/pedidos_date_filter_today"
            android:textColor="@color/brand_accent"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ── Lista de rutas ────────────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerOtrosPedidosList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp"
            android:scrollbars="none"
            tools:listitem="@layout/item_otros_route" />

        <ProgressBar
            android:id="@+id/progressOtrosPedidosList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textOtrosPedidosListEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/otros_pedidos_empty"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
