<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de pedido (cliente) — rediseño "Bosque Pro".
     Conserva ids del adapter: textClienteNombre, textSyncStatus, textFecha, textTotal,
     textItemCount, menuButtonPedido, printButtonPedido. Nuevo: textClienteInicial. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/brand_soft"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Avatar con iniciales -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="46dp"
            android:layout_height="46dp"
            app:cardBackgroundColor="@color/brand_soft"
            app:cardCornerRadius="23dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/textClienteInicial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/brand_soft_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="TR" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Nombre + meta + estado -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textClienteNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                tools:text="Tienda Rosita" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textItemCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    tools:text="8 ítems" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:fontFamily="sans-serif"
                    android:text="·"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textFecha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    tools:text="20 Feb 2026" />
            </LinearLayout>

            <TextView
                android:id="@+id/textSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/bg_muted"
                android:fontFamily="sans-serif"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                tools:text="✓ Sincronizado" />
        </LinearLayout>

        <!-- Acciones + total -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/printButtonPedido"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Imprimir ticket"
                    android:padding="6dp"
                    android:src="@drawable/ic_print"
                    app:tint="@color/text_tertiary" />

                <ImageButton
                    android:id="@+id/menuButtonPedido"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Más opciones"
                    android:padding="6dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <TextView
                android:id="@+id/textTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="4dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/brand_accent"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Q1,301.66" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
