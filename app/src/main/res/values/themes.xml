<resources>
    <!-- Base application theme. -->
    <style name="Theme.Distribuidora" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorPrimaryVariant">@color/app_primary_dark</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>

        <item name="colorSecondary">@color/app_secondary</item>
        <item name="colorSecondaryVariant">@color/palette_300</item>
        <item name="colorOnSecondary">@color/palette_900</item>

        <!-- Background / surfaces -->
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>

        <!-- Text colours (android: namespace attrs used by system widgets) -->
        <item name="android:textColorPrimary">@color/palette_900</item>
        <item name="android:textColorSecondary">@color/palette_600</item>

        <!-- Status / Nav bars oscuras (íconos claros) -->
        <item name="android:statusBarColor">@color/palette_900</item>
        <item name="android:navigationBarColor">@color/palette_900</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Error: tono oscuro de la paleta + icono/texto comunica el error -->
        <item name="colorError">@color/palette_800</item>
        <item name="colorOnError">@color/palette_050</item>

        <!-- Material default component styling (keeps typography default) -->
        <item name="textInputStyle">@style/Widget.Distribuidora.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.Distribuidora.LoginButton</item>
    </style>

    <!-- ===== Login styles (UI-only) ===== -->

    <style name="TextAppearance.Distribuidora.LoginTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/login_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Distribuidora.LoginSubtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/login_text_secondary</item>
    </style>

    <style name="TextAppearance.Distribuidora.Error" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/login_error</item>
    </style>

    <style name="Widget.Distribuidora.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxStrokeColor">@color/app_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/login_text_secondary</item>
    </style>

    <style name="Widget.Distribuidora.LoginButton" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textColor">@color/app_on_primary</item>
        <item name="backgroundTint">@color/app_primary</item>
        <item name="iconPadding">8dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- ProgressBar estándar (no Material3 ProgressIndicator) -->
    <style name="Widget.Distribuidora.Progress" parent="@android:style/Widget.ProgressBar" />

    <!-- Diálogo con fondo claro, independiente del modo oscuro del tema padre -->
    <style name="Theme.Distribuidora.Dialog.Light" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorPrimaryVariant">@color/app_primary_dark</item>
        <item name="colorSecondary">@color/app_secondary</item>
        <item name="android:colorBackground">@color/app_surface</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>
    </style>

    <!-- DatePicker con mejor espaciado -->
    <style name="ThemeOverlay.Distribuidora.MaterialCalendar" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="materialCalendarHeaderTitle">@style/Widget.Distribuidora.MaterialCalendar.HeaderTitle</item>
        <item name="materialCalendarHeaderSelection">@style/Widget.Distribuidora.MaterialCalendar.HeaderSelection</item>
    </style>

    <style name="Widget.Distribuidora.MaterialCalendar.HeaderTitle" parent="Widget.MaterialComponents.MaterialCalendar.HeaderTitle">
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.Distribuidora.MaterialCalendar.HeaderSelection" parent="Widget.MaterialComponents.MaterialCalendar.HeaderSelection">
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <!-- Shape appearance con esquinas redondeadas de 8dp -->
    <style name="ShapeAppearance.App.RoundedCorner8" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- ===== Aliases Material3 → MaterialComponents (M2 compat) =====
         El tema usa Theme.MaterialComponents (M2), pero algunos layouts referencian
         TextAppearance.Material3.*. Estos aliases los mapean a sus equivalentes M2
         para evitar crashes en runtime sin tener que editar todos los layouts. -->
    <style name="TextAppearance.Material3.DisplayLarge"  parent="TextAppearance.MaterialComponents.Headline1" />
    <style name="TextAppearance.Material3.DisplayMedium" parent="TextAppearance.MaterialComponents.Headline2" />
    <style name="TextAppearance.Material3.DisplaySmall"  parent="TextAppearance.MaterialComponents.Headline3" />
    <style name="TextAppearance.Material3.HeadlineLarge"  parent="TextAppearance.MaterialComponents.Headline4" />
    <style name="TextAppearance.Material3.HeadlineMedium" parent="TextAppearance.MaterialComponents.Headline5" />
    <style name="TextAppearance.Material3.HeadlineSmall"  parent="TextAppearance.MaterialComponents.Headline6" />
    <style name="TextAppearance.Material3.TitleLarge"   parent="TextAppearance.MaterialComponents.Headline6" />
    <style name="TextAppearance.Material3.TitleMedium"  parent="TextAppearance.MaterialComponents.Subtitle1" />
    <style name="TextAppearance.Material3.TitleSmall"   parent="TextAppearance.MaterialComponents.Subtitle2" />
    <style name="TextAppearance.Material3.BodyLarge"    parent="TextAppearance.MaterialComponents.Body1" />
    <style name="TextAppearance.Material3.BodyMedium"   parent="TextAppearance.MaterialComponents.Body2" />
    <style name="TextAppearance.Material3.BodySmall"    parent="TextAppearance.MaterialComponents.Caption" />
    <style name="TextAppearance.Material3.LabelLarge"   parent="TextAppearance.MaterialComponents.Button" />
    <style name="TextAppearance.Material3.LabelMedium"  parent="TextAppearance.MaterialComponents.Caption" />
    <style name="TextAppearance.Material3.LabelSmall"   parent="TextAppearance.MaterialComponents.Overline" />

</resources>